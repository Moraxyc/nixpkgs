From: Moraxyc <i@qaq.li>
Subject: [PATCH] tests/chip.c: fix dangling stack pointer in setup_bad_chip()

setup_bad_chip() declared `struct flashchip mock_chip = chip_bad;` as a
local variable and passed its address to setup_chip(), which stores the
pointer in `flashctx->chip`. Once setup_bad_chip() returned,
`flashctx->chip` became a dangling pointer; subsequent calls such as
`calloc()` in read_chip_bad_status_test() can overwrite that stack slot
(observed on musl), corrupting `flashctx->chip->total_size` and causing
flashrom_image_read() to return 2 instead of
ERROR_FLASHROM_PREPARE_FLASH_ACCESS.

Match the rest of tests/chip.c by keeping `mock_chip` in the caller's
stack frame for the lifetime of `flashctx`.

--- a/tests/chip.c
+++ b/tests/chip.c
@@ -772,7 +772,8 @@ void verify_chip_with_dummyflasher_test_success(void **state)
 	free(newcontents);
 }
 
-static void setup_bad_chip(struct flashrom_flashctx *flashctx)
+static void setup_bad_chip(struct flashrom_flashctx *flashctx,
+		struct flashchip *mock_chip)
 {
 	/* This test injectors are not expected to be called, because the
 	 * chip has known bad test status and chip_safety_check should fail
@@ -781,10 +782,10 @@ static void setup_bad_chip(struct flashrom_flashctx *flashctx)
 	g_test_read_injector = NULL;
 	g_test_erase_injector[0] = NULL;
 
-	struct flashchip mock_chip = chip_bad;
+	*mock_chip = chip_bad;
 	const char *param = ""; /* Default values for all params. */
 
-	setup_chip(flashctx, &mock_chip, param, NULL);
+	setup_chip(flashctx, mock_chip, param, NULL);
 }
 
 void erase_chip_bad_status_test(void **state)
@@ -792,7 +793,8 @@ void erase_chip_bad_status_test(void **state)
 	(void) state; /* unused */
 
 	struct flashrom_flashctx flashctx = {0};
-	setup_bad_chip(&flashctx);
+	struct flashchip mock_chip;
+	setup_bad_chip(&flashctx, &mock_chip);
 
 	printf("flashrom_flash_erase called: ");
 	assert_int_equal(ERROR_FLASHROM_PREPARE_FLASH_ACCESS, flashrom_flash_erase(&flashctx));
@@ -806,7 +808,8 @@ void read_chip_bad_status_test(void **state)
 	(void) state; /* unused */
 
 	struct flashrom_flashctx flashctx = {0};
-	setup_bad_chip(&flashctx);
+	struct flashchip mock_chip;
+	setup_bad_chip(&flashctx, &mock_chip);
 
 	unsigned long size = chip_bad.total_size * 1024;
 	unsigned char *buf = calloc(size, sizeof(unsigned char));
@@ -827,7 +830,8 @@ void write_chip_bad_status_test(void **state)
 	(void) state; /* unused */
 
 	struct flashrom_flashctx flashctx = {0};
-	setup_bad_chip(&flashctx);
+	struct flashchip mock_chip;
+	setup_bad_chip(&flashctx, &mock_chip);
 
 	unsigned long size = chip_bad.total_size * 1024;
 	uint8_t *const newcontents = malloc(size);
