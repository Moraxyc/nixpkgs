From: Moraxyc <i@qaq.li>
Subject: [PATCH] virtio/fs/linux: use SYS_statx syscall directly on musl

The Rust libc crate does not expose libc::statx, STATX_BASIC_STATS, or
STATX_MNT_ID on Linux musl targets. Define the kernel UAPI statx layout
and invoke libc::SYS_statx via libc::syscall() when target_env = "musl".

--- a/src/devices/src/virtio/fs/linux/passthrough.rs
+++ b/src/devices/src/virtio/fs/linux/passthrough.rs
@@ -195,14 +195,55 @@
     }
 }
 
+#[cfg(target_env = "musl")]
+#[repr(C)]
+struct StatxTimestamp {
+    tv_sec: i64,
+    tv_nsec: u32,
+    __pad1: [i32; 1],
+}
+
+#[cfg(target_env = "musl")]
+#[repr(C)]
+struct Statx {
+    stx_mask: u32,
+    stx_blksize: u32,
+    stx_attributes: u64,
+    stx_nlink: u32,
+    stx_uid: u32,
+    stx_gid: u32,
+    stx_mode: u16,
+    __pad1: [u16; 1],
+    stx_ino: u64,
+    stx_size: u64,
+    stx_blocks: u64,
+    stx_attributes_mask: u64,
+    stx_atime: StatxTimestamp,
+    stx_btime: StatxTimestamp,
+    stx_ctime: StatxTimestamp,
+    stx_mtime: StatxTimestamp,
+    stx_rdev_major: u32,
+    stx_rdev_minor: u32,
+    stx_dev_major: u32,
+    stx_dev_minor: u32,
+    stx_mnt_id: u64,
+    stx_dio_mem_align: u32,
+    stx_dio_offset_align: u32,
+    __pad3: [u64; 12],
+}
+
 fn statx(f: &File) -> io::Result<(libc::stat64, u64)> {
+    #[cfg(not(target_env = "musl"))]
     let mut stx = MaybeUninit::<libc::statx>::zeroed();
+    #[cfg(target_env = "musl")]
+    let mut stx = MaybeUninit::<Statx>::zeroed();
 
     // Safe because this is a constant value and a valid C string.
     let pathname = unsafe { CStr::from_bytes_with_nul_unchecked(EMPTY_CSTR) };
 
     // Safe because the kernel will only write data in `st` and we check the return
     // value.
+    #[cfg(not(target_env = "musl"))]
     let res = unsafe {
         libc::statx(
             f.as_raw_fd(),
@@ -212,6 +253,19 @@
             stx.as_mut_ptr(),
         )
     };
+    #[cfg(target_env = "musl")]
+    let res = unsafe {
+        const STATX_BASIC_STATS: u32 = 0x07ff;
+        const STATX_MNT_ID: u32 = 0x1000;
+        libc::syscall(
+            libc::SYS_statx,
+            f.as_raw_fd(),
+            pathname.as_ptr(),
+            libc::AT_EMPTY_PATH | libc::AT_SYMLINK_NOFOLLOW,
+            STATX_BASIC_STATS | STATX_MNT_ID,
+            stx.as_mut_ptr(),
+        )
+    };
     if res >= 0 {
         // Safe because the kernel guarantees that the struct is now fully initialized.
         let stx = unsafe { stx.assume_init() };
